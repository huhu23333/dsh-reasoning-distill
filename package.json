{
  "name": "dsh-reasoning-distill",
  "version": "0.1.1",
  "type": "module",
  "description": "Distill over-long model reasoning into its useful core and replay the distilled version on every later request, with a per-session cost report.",
  "license": "MIT",
  "author": "huhu233 <925393268@qq.com>",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "docs",
    "scripts/install-backend.sh",
    "scripts/lib",
    "scripts/dsh-inplace-patch.mjs",
    "scripts/probe-inplace-durability.mjs",
    "scripts/patch-message-edit.py",
    "vendor/dsh-message-edit-0.2.3-patched4.tgz"
  ],
  "scripts": {
    "build": "tsdown",
    "watch": "tsdown --watch",
    "prepare": "tsdown",
    "prepublishOnly": "npm run build",
    "test:smoke": "tsdown --config tsdown.smoke.config.ts && node test/dist/smoke.js",
    "test:render": "tsdown --config tsdown.render.config.ts && node test/dist/render.js",
    "test": "npm run test:smoke && npm run test:render",
    "typecheck": "npm run typecheck:host && npm run typecheck:client",
    "check": "npm run typecheck && npm test",
    "typecheck:all": "tsc --noEmit -p tsconfig.json",
    "typecheck:host": "tsc --noEmit -p tsconfig.host.json",
    "typecheck:client": "tsc --noEmit -p tsconfig.client.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-alpha.1": "compatible"
      },
      "node": ">=20"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "reasoning",
    "thinking",
    "distill",
    "token",
    "cache"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huhu23333/dsh-reasoning-distill.git"
  },
  "homepage": "https://github.com/huhu23333/dsh-reasoning-distill#readme",
  "bugs": {
    "url": "https://github.com/huhu23333/dsh-reasoning-distill/issues"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-settings": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "lightningcss": "^1.32.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  }
}
